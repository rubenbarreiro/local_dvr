rtsp:
  url: "rtsp://username:password@192.168.1.100:554/stream"
  reconnect_interval: 5  # seconds

recording:
  enabled: true
  output_dir: "./recordings"
  filename_pattern: "recording_%Y%m%d_%H%M%S.mp4"
  segment_duration: 3600  # seconds (1 hour)
  codec: "copy"          # video stream is remuxed, never decoded (low memory)
  audio_codec: "aac"     # re-encode camera PCM audio (required for MP4)
  audio_bitrate: "64k"
  fragmented: true       # crash/power-loss resilient segments (fragmented MP4)
  max_muxing_queue: 128  # bounds muxer buffering memory on slow storage

display:
  # Live preview is CPU/RAM intensive; keep disabled on Raspberry Pi Zero W.
  enabled: false
  host: "0.0.0.0"
  port: 8080

general:
  log_level: "INFO"
